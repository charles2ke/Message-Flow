{
  "name": "@charles2ke/messageflow",
  "version": "1.0.0",
  "description": "A dependency-free Chain of Responsibility library for Node.js and browsers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "clean": "rm -rf dist dist-test *.tsbuildinfo"
  },
  "keywords": [
    "chain-of-responsibility",
    "pipeline",
    "middleware",
    "handler",
    "request",
    "response"
  ],
  "author": "charles2ke",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charles2ke/Message-Flow.git",
    "directory": "node"
  },
  "homepage": "https://github.com/charles2ke/Message-Flow/blob/main/node/README.md",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
